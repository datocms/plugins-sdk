{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": false,
    "types": [],
    "paths": {
      "react": ["../../node_modules/types-react-18"],
      "react/*": ["../../node_modules/types-react-18/*"],
      "react-dom": ["../../node_modules/types-react-dom-18"],
      "react-dom/*": ["../../node_modules/types-react-dom-18/*"]
    }
  },
  "include": ["dist/**/*.d.ts"]
}
